# Copy this file to .env.local and fill in your Supabase project's values.
# .env.local is gitignored — never commit real keys.

# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only, full access — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same URL, plus the public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paddle — sandbox/test mode for now (see README Status). Dashboard: sandbox-vendors.paddle.com
# Developer Tools > Authentication > API keys (sandbox).
PADDLE_API_KEY=
# Developer Tools > Notifications > your webhook destination > "Endpoint secret key".
PADDLE_WEBHOOK_SECRET=
# Catalog > Products — create one product (e.g. "Leaderboard listing") to
# attach every bid's ad-hoc price to, then paste its id (pro_...) here.
PADDLE_PRODUCT_ID=
# Developer Tools > Authentication > Client-side tokens (sandbox) — safe to expose to the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" when going live.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Admin area (/admin) — single shared password, no per-user accounts.
ADMIN_PASSWORD=choose-a-strong-password
# Optional: a separate secret for signing the admin session cookie. Falls
# back to ADMIN_PASSWORD itself if omitted.
# ADMIN_SESSION_SECRET=

# Encrypts (reversibly) the copy of a listing's manage-token that lets admin
# decrypt-and-copy its current live link. 32 bytes, hex-encoded — generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGE_TOKEN_ENCRYPTION_KEY=generate-a-32-byte-hex-key
